+#!/usr/bin/env node
+/**
+ * Generate a signed Sigma embed URL from environment variables.
+ *
+ * Required env vars:
+ *   SIGMA_BASE_URL       Embed target URL copied from Sigma (workbook, page,
+ *                        element, data model, report, or tagged version).
+ *   SIGMA_CLIENT_ID      Embed client ID (used as the JWT `kid` and `iss`).
+ *   SIGMA_SECRET         Embed secret (HS256 signing key).
+ *   SIGMA_EMAIL          Email address for the `sub` claim. Must be RFC-1035
+ *                        compliant (no whitespace, no underscores).
+ *
+ * Optional env vars:
+ *   SIGMA_SESSION_LENGTH   Seconds until JWT expiry. Default 3600, max 2592000.
+ *   SIGMA_ACCOUNT_TYPE     Account type to assign to an auto-created embed user.
+ *                          Omit for internal users (who have a Sigma account).
+ *   SIGMA_TEAMS            Comma-separated team names for an embed user.
+ *                          Omit for internal users.
+ *   SIGMA_USER_ATTRIBUTES  JSON object of user-attribute name/value pairs.
+ *                          Drives RLS, CLS, and warehouse role switching.
+ *
+ * Usage:
+ *   SIGMA_BASE_URL=... SIGMA_CLIENT_ID=... SIGMA_SECRET=... SIGMA_EMAIL=... \
+ *   node generate-embed-url.js
+ */
+
+'use strict';
+
+const { createHmac, randomUUID } = require('node:crypto');
+
+const required = ['SIGMA_BASE_URL', 'SIGMA_CLIENT_ID', 'SIGMA_SECRET', 'SIGMA_EMAIL'];
+const missing = required.filter((k) => !process.env[k]);
+if (missing.length) {
+  process.stderr.write(`Error: missing required env var(s): ${missing.join(', ')}\n`);
+  process.exit(1);
+}
+
+const baseUrl  = process.env.SIGMA_BASE_URL;
+const clientId = process.env.SIGMA_CLIENT_ID;
+const secret   = process.env.SIGMA_SECRET;
+const email    = process.env.SIGMA_EMAIL;
+
+const sessionLength = Math.min(
+  parseInt(process.env.SIGMA_SESSION_LENGTH || '3600', 10),
+  2592000
+);
+
+const extraClaims = {};
+if (process.env.SIGMA_ACCOUNT_TYPE) {
+  extraClaims.account_type = process.env.SIGMA_ACCOUNT_TYPE;
+}
+if (process.env.SIGMA_TEAMS) {
+  extraClaims.teams = process.env.SIGMA_TEAMS.split(',').map((s) => s.trim()).filter(Boolean);
+}
+if (process.env.SIGMA_USER_ATTRIBUTES) {
+  try {
+    extraClaims.user_attributes = JSON.parse(process.env.SIGMA_USER_ATTRIBUTES);
+  } catch (err) {
+    process.stderr.write(`Error: SIGMA_USER_ATTRIBUTES is not valid JSON: ${err.message}\n`);
+    process.exit(1);
+  }
+}
+
+const b64url = (obj) => Buffer.from(JSON.stringify(obj)).toString('base64url');
+
+const now = Math.floor(Date.now() / 1000);
+const header = { alg: 'HS256', typ: 'JWT', kid: clientId };
+const payload = {
+  sub: email,
+  iss: clientId,
+  jti: randomUUID(),
+  iat: now,
+  exp: now + sessionLength,
+  ...extraClaims,
+};
+
+const unsigned = `${b64url(header)}.${b64url(payload)}`;
+const sig      = createHmac('sha256', secret).update(unsigned).digest('base64url');
+const token    = `${unsigned}.${sig}`;
+
+process.stdout.write(`${baseUrl}?:jwt=${encodeURIComponent(token)}&:embed=true\n`);
