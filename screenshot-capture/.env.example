# Copy to .env and fill in. Do NOT commit .env.
# Embed credentials (from Sigma Administration > Developer Access):
SIGMA_EMBED_CLIENT_ID=your_embed_client_id
SIGMA_EMBED_SECRET=your_embed_secret

# The workbook URL to embed. Use the workbook's URL from the browser, or the
# "Embed path" from the workbook's Embed settings, e.g.:
#   https://app.sigmacomputing.com/<org-slug>/workbook/<workbookId>
WORKBOOK_EMBED_URL=https://app.sigmacomputing.com/your-org/workbook/your-workbook-id

# Optional: session length in seconds (max 2592000).
SIGMA_SESSION_LENGTH=3600

# Optional overrides:
# TENANTS_FILE=tenants.json
# OUT_DIR=screenshots
